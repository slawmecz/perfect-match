# Public site URL used for canonical tags, OpenGraph and JSON-LD.
# In production this should be the final domain.
NEXT_PUBLIC_SITE_URL=https://kojarzeniepar.pl

# Base path for GitHub Pages project sites (e.g. /perfect-match).
# Leave empty when serving from a custom domain or the repo root.
NEXT_PUBLIC_BASE_PATH=

# Google Analytics 4 measurement ID (kojarzeniepar stream).
NEXT_PUBLIC_GA_ID=G-4JRS7BGB0M
